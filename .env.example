# Copy to .env, then: docker compose up --build, and pnpm dev for the web app

# URL-safe database password: openssl rand -hex 16
POSTGRES_PASSWORD=

# Encrypts users' AI provider keys at rest. 32 bytes, base64: openssl rand -base64 32
# Changing it later makes saved keys unreadable (users re-enter them).
OPENNOTES_SECRET=

# Set true when serving over HTTPS.
COOKIE_SECURE=false
# Where people open the app; used in sign-in emails.
PUBLIC_URL=http://localhost:5173
# Email (sign-in codes and links, share invites). EMAIL_DRIVER=fs writes each message to EMAIL_FS_DIR
# inside the server container and logs its subject, which carries the sign-in code: `just logs`.
# For real delivery: EMAIL_DRIVER=resend plus EMAIL_RESEND_API_KEY and a verified EMAIL_FROM domain.
EMAIL_DRIVER=fs
EMAIL_FROM=opennotes <notes@example.com>
EMAIL_REPLY_TO=
EMAIL_RESEND_API_KEY=
# Uploaded files. fs keeps them in the `files` volume. s3 uses any S3-compatible bucket (AWS S3, Cloudflare R2,
# MinIO, …): set the AWS_* values; AWS_ENDPOINT only for non-AWS services, AWS_ALLOW_HTTP=true for a plain-http one.
STORAGE_DRIVER=fs
AWS_BUCKET=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT=
AWS_ALLOW_HTTP=
# Set false to stop new sign-ups after creating your account.
ALLOW_SIGNUP=true
# Hostnames MCP clients may reach this server by (DNS-rebinding guard). Add your domain when deploying.
OPENNOTES_HOSTS=localhost,127.0.0.1
# Let users point "Custom" AI providers at private/local addresses (e.g. Ollama). Only if you trust every account.
ALLOW_PRIVATE_AI_URLS=false
# Production only (docker-compose.prod.yml): the domain Caddy gets a TLS certificate for.
DOMAIN=
# Log levels (default info) and format: json for log shippers, plain otherwise.
RUST_LOG=info
LOG_FORMAT=
