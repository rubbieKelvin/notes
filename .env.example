# Copy to .env, then: docker compose up --build

# URL-safe database password: openssl rand -hex 16
POSTGRES_PASSWORD=

# Encrypts users' AI provider keys at rest. 32 bytes, base64: openssl rand -base64 32
# Changing it later makes saved keys unreadable (users re-enter them).
OPENNOTES_SECRET=

# Set true when serving over HTTPS.
COOKIE_SECURE=false
# Set false to stop new sign-ups after creating your account.
ALLOW_SIGNUP=true
# Hostnames MCP clients may reach this server by (DNS-rebinding guard). Add your domain when deploying.
OPENNOTES_HOSTS=localhost,127.0.0.1
# Let users point "Custom" AI providers at private/local addresses (e.g. Ollama). Only if you trust every account.
ALLOW_PRIVATE_AI_URLS=false
PORT=3000
