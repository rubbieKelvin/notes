---
import '@fontsource-variable/inter'
import '@fontsource/instrument-serif'
import '@fontsource/instrument-serif/400-italic.css'

const app = import.meta.env.PUBLIC_APP_URL ?? 'http://localhost:5173'
const repo = 'https://github.com/rubbieKelvin/notes'

const ideas = [
  { title: 'A blank sheet, first', body: 'No sidebars, no folder trees, no setup. The cursor is already on the page.' },
  { title: 'Canvas, between paragraphs', body: 'Type /canvas to sketch inline. Expand it full-screen when the idea needs room, then fold it back into your prose.' },
  { title: 'AI in the margin', body: 'Highlight a word for a two-line note beside it. Your sentences are never rewritten, only annotated.' },
  { title: 'Context for your agents', body: 'Expose a page as an MCP endpoint for Claude Code or Cursor. Their notes land in a quiet inbox, not on your page.' },
]
const commands = ['/canvas', '/math', '/hypothesis', '/evidence', '/runbook', '/clip']
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>opennotes — the last notebook you'll ever need</title>
    <meta name="description" content="A blank sheet for writing, with inline canvases, AI notes that stay in the margin, and an MCP endpoint for your agents." />
  </head>
  <body>
    <header class="wrap nav">
      <a href="/" class="wordmark">opennotes</a>
      <nav>
        <a href={repo}>GitHub</a>
        <a href={app} class="signin">Sign in</a>
      </nav>
    </header>

    <main>
      <section class="wrap hero">
        <p class="eyebrow">Open source · Self-hostable</p>
        <h1>The last notebook<br /><em>you'll ever need.</em></h1>
        <p class="lede">
          Open it, see a blank sheet, start writing. Canvases, AI and agents are there when you reach for them,
          and out of the way when you don't.
        </p>
        <div class="ctas">
          <a href={app} class="btn primary">Start writing <span aria-hidden="true">→</span></a>
          <a href={repo} class="btn">View the source</a>
        </div>
      </section>

      <section class="wrap" aria-label="What a page looks like">
        <figure class="sheet">
          <div class="bar">
            <span class="crumb"><span class="muted">opennotes /</span> Box geometry</span>
            <span class="pills">
              <span class="pill ai"><span class="dot"></span>2 AI</span>
              <span class="pill">MCP · Live</span>
              <span class="pill kbd">⌘K</span>
            </span>
          </div>

          <div class="page">
            <div class="prose">
              <p>
                I like boxes. They are usually the same size in <mark>height</mark>, width, and breadth, which
                makes them easy to reason about.
              </p>
              <aside class="whisper">
                <span class="tag">AI</span>
                Equal sides make it a cube: volume is s³, surface area 6s².
              </aside>
            </div>

            <div class="canvas">
              <span class="expand">⤢ Expand</span>
              <svg viewBox="0 0 520 170" role="img" aria-label="A sketch: V = s³ leads to Surface = 6s²">
                <g fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M42 52 C 90 49, 130 51, 158 53 C 160 80, 159 104, 157 120 C 120 122, 80 121, 44 119 C 42 96, 41 72, 42 52 Z" />
                  <path d="M322 50 C 380 48, 440 49, 482 52 C 484 78, 483 102, 481 122 C 430 124, 370 123, 324 121 C 322 98, 321 72, 322 50 Z" />
                  <path d="M170 86 C 210 82, 260 90, 306 85" class="ink-ai" />
                  <path d="M296 77 L 308 85 L 297 94" class="ink-ai" />
                </g>
                <text x="100" y="92" text-anchor="middle" class="hand">V = s³</text>
                <text x="402" y="92" text-anchor="middle" class="hand">Surface = 6s²</text>
                <text x="238" y="72" text-anchor="middle" class="note">supports</text>
              </svg>
            </div>

            <p class="placeholder">Type ‘/’ for commands, or highlight any word for a note…</p>
          </div>
        </figure>
      </section>

      <section class="wrap ideas">
        {ideas.map((i, n) => (
          <article>
            <span class="num">0{n + 1}</span>
            <h2>{i.title}</h2>
            <p>{i.body}</p>
          </article>
        ))}
      </section>

      <section class="wrap commands" aria-label="Slash commands">
        <p>Everything else is a keystroke away.</p>
        <ul>{commands.map((c) => <li><code>{c}</code></li>)}</ul>
      </section>

      <section class="wrap agents">
        <div>
          <h2>Your notes, as <em>context.</em></h2>
          <p>
            Pick the pages your coding agent should read. It gets curated human notes, not a landfill of
            summaries, and anything it wants to tell you waits in the inbox until you say so.
          </p>
        </div>
        <pre><code><span class="muted">$</span> claude mcp add --transport http opennotes \
    https://your-host/mcp \
    --header "Authorization: Bearer $TOKEN"

<span class="muted">$</span> opennotes push &lt; error.log
<span class="muted"># → lands in ● AI, never on the page</span></code></pre>
      </section>

      <section class="wrap closing">
        <h2>Start with a blank page.</h2>
        <a href={app} class="btn primary">Open opennotes <span aria-hidden="true">→</span></a>
      </section>
    </main>

    <footer class="wrap foot">
      <span>opennotes</span>
      <span class="muted">MIT licensed · <a href={repo}>Self-host it</a></span>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --bg: #fafaf9;
    --paper: #ffffff;
    --ink: #171717;
    --muted: #737371;
    --line: #e7e7e5;
    --green: #15803d;
    --ai: #9c27b0;
    --ai-soft: #fdefff;
    --ai-line: #e5adef;
    --serif: 'Instrument Serif', ui-serif, Georgia, serif;
    --sans: 'Inter Variable', ui-sans-serif, system-ui, sans-serif;
    --mono: ui-monospace, 'SF Mono', Menlo, monospace;
  }
  * { box-sizing: border-box; margin: 0; }
  html { background: var(--bg); color: var(--ink); font: 16px/1.6 var(--sans); -webkit-font-smoothing: antialiased; }
  a { color: inherit; text-decoration: none; }
  ::selection { background: #f5dff9; }
  :focus-visible { outline: 2px solid #86efac; outline-offset: 3px; border-radius: 4px; }
  .muted { color: var(--muted); }
  .wrap { width: min(1040px, 100% - 3rem); margin-inline: auto; }
  em { font-style: italic; }
  h1, h2 { font-family: var(--serif); font-weight: 400; letter-spacing: -0.01em; }

  .nav { display: flex; justify-content: space-between; align-items: center; padding-block: 1.5rem; }
  .wordmark { font-weight: 600; letter-spacing: -0.02em; }
  .nav nav { display: flex; gap: 1.75rem; font-size: 0.9rem; color: var(--muted); }
  .nav nav a:hover, .signin { color: var(--ink); }

  .hero { text-align: center; padding-block: 6rem 4rem; }
  .eyebrow { font-size: 0.8rem; color: var(--muted); letter-spacing: 0.04em; }
  h1 { font-size: clamp(3rem, 8vw, 5.75rem); line-height: 1; margin-block: 1.25rem 1.5rem; }
  h1 em { color: var(--muted); }
  .lede { max-width: 34rem; margin-inline: auto; color: var(--muted); font-size: 1.1rem; }
  .ctas { display: flex; gap: 0.75rem; justify-content: center; margin-top: 2.25rem; flex-wrap: wrap; }
  .btn { display: inline-flex; gap: 0.4rem; align-items: center; padding: 0.65rem 1.15rem; border-radius: 999px; border: 1px solid var(--line); background: var(--paper); font-size: 0.92rem; font-weight: 500; transition: border-color 0.2s, transform 0.2s; }
  .btn:hover { border-color: #d4d4d2; }
  .btn.primary { background: var(--ink); border-color: var(--ink); color: #fff; }
  .btn.primary:hover { transform: translateY(-1px); }

  .sheet { background: var(--paper); border: 1px solid var(--line); border-radius: 14px; overflow: hidden; }
  .bar { display: flex; justify-content: space-between; align-items: center; padding: 0.85rem 1.25rem; font-size: 0.82rem; gap: 1rem; }
  .pills { display: flex; gap: 0.4rem; }
  .pill { border: 1px solid var(--line); border-radius: 999px; padding: 0.15rem 0.6rem; color: var(--muted); font-size: 0.75rem; white-space: nowrap; }
  .pill.ai { color: var(--ai); display: inline-flex; align-items: center; gap: 0.35rem; }
  .dot { width: 6px; height: 6px; border-radius: 50%; background: var(--ai); animation: pulse 2.4s ease-in-out infinite; }
  .kbd { font-family: var(--mono); }
  .page { max-width: 640px; margin-inline: auto; padding: 3.5rem 1.5rem 4rem; position: relative; }
  .prose { position: relative; font-size: 1.1rem; line-height: 1.75; }
  mark { background: var(--ai-soft); color: inherit; border-radius: 3px; text-decoration: underline dotted var(--ai-line); text-underline-offset: 5px; }
  .whisper { position: absolute; left: calc(100% + 2rem); top: 0.1rem; width: 10rem; font-size: 0.8rem; line-height: 1.5; color: #57574f; border-left: 1px solid var(--ai-line); padding-left: 0.85rem; }
  .whisper::before { content: ''; position: absolute; right: 100%; top: 0.75rem; width: 2rem; border-top: 1px dashed var(--ai-line); }
  .tag { display: block; font-size: 0.65rem; font-weight: 600; letter-spacing: 0.08em; color: var(--ai); margin-bottom: 0.15rem; }
  .canvas { position: relative; margin-block: 2rem; border: 1px solid var(--line); border-radius: 10px; color: #44443f;
    background: radial-gradient(circle, #e7e7e5 1px, transparent 1px) 0 0 / 18px 18px; }
  .canvas svg { display: block; width: 100%; height: auto; }
  .ink-ai { stroke: var(--ai); }
  .hand { font: 400 22px var(--serif); fill: currentColor; }
  .note { font: italic 400 15px var(--serif); fill: var(--ai); }
  .expand { position: absolute; top: 0.6rem; right: 0.7rem; font-size: 0.72rem; color: var(--muted); background: var(--paper); border: 1px solid var(--line); border-radius: 6px; padding: 0.1rem 0.45rem; }
  .placeholder { color: #c4c4c2; font-size: 1.05rem; }

  .ideas { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 2.5rem; padding-block: 7rem 5rem; }
  .ideas .num { font: 0.75rem var(--mono); color: var(--muted); }
  .ideas h2 { font-size: 1.65rem; line-height: 1.15; margin-block: 0.75rem 0.6rem; }
  .ideas p { color: var(--muted); font-size: 0.95rem; }

  .commands { border-block: 1px solid var(--line); padding-block: 2.25rem; display: flex; justify-content: space-between; align-items: center; gap: 1.5rem; flex-wrap: wrap; }
  .commands p { font-family: var(--serif); font-size: 1.5rem; }
  .commands ul { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .commands code { font: 0.85rem var(--mono); padding: 0.3rem 0.65rem; border-radius: 6px; background: var(--paper); border: 1px solid var(--line); }

  .agents { display: grid; grid-template-columns: 1fr 1.2fr; gap: 3.5rem; align-items: center; padding-block: 7rem; }
  .agents h2 { font-size: clamp(2.2rem, 4.5vw, 3.25rem); line-height: 1.05; margin-bottom: 1.25rem; }
  .agents h2 em { color: var(--ai); }
  .agents p { color: var(--muted); }
  pre { background: #171717; color: #e7e7e5; border-radius: 12px; padding: 1.5rem 1.75rem; font: 0.82rem/1.8 var(--mono); overflow-x: auto; }
  pre .muted { color: #737371; }

  .closing { text-align: center; padding-block: 5rem 7rem; }
  .closing h2 { font-size: clamp(2.5rem, 6vw, 4rem); margin-bottom: 2rem; }

  .foot { display: flex; justify-content: space-between; border-top: 1px solid var(--line); padding-block: 2rem; font-size: 0.85rem; }
  .foot a { text-decoration: underline; text-underline-offset: 3px; }

  @keyframes pulse { 50% { opacity: 0.35; } }
  @media (prefers-reduced-motion: reduce) { * { animation: none !important; transition: none !important; } }

  /* No room for a side margin: the whisper sits under its line instead. */
  @media (max-width: 1100px) {
    .whisper { position: static; width: auto; margin-top: 1rem; }
    .whisper::before { display: none; }
  }
  @media (max-width: 760px) {
    .agents { grid-template-columns: 1fr; gap: 2rem; padding-block: 5rem; }
    .hero { padding-block: 4rem 3rem; }
    .pills .pill:not(.ai) { display: none; }
  }
</style>
