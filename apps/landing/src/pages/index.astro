---
import '@fontsource-variable/inter'

const app = import.meta.env.PUBLIC_APP_URL ?? 'http://localhost:5173'
const repo = 'https://github.com/rubbieKelvin/notes'
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>opennotes</title>
    <meta name="description" content="A blank sheet for writing, with inline canvases and AI that stays in the margin." />
  </head>
  <body>
    <header class="nav">
      <a href="/">opennotes</a>
      <a href={repo} class="muted">GitHub</a>
    </header>

    <main>
      <h1>The last notebook <span class="muted">you'll ever need.</span></h1>
      <a href={app} class="btn">Start writing →</a>

      <figure class="sheet" aria-hidden="true">
        <div class="bar">
          <span><span class="muted">opennotes /</span> Box geometry</span>
          <span class="pill"><span class="dot"></span>2 AI</span>
        </div>
        <div class="page">
          <p class="prose">
            I like boxes. They are usually the same size in <mark>height</mark>, width, and breadth.
            <span class="whisper"><span class="tag">AI</span>Equal sides make a cube: V = s³.</span>
          </p>
          <div class="canvas">
            <svg viewBox="0 0 520 150">
              <g fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M42 42 C 90 39, 130 41, 158 43 C 160 70, 159 94, 157 110 C 120 112, 80 111, 44 109 C 42 86, 41 62, 42 42 Z" />
                <path d="M322 40 C 380 38, 440 39, 482 42 C 484 68, 483 92, 481 112 C 430 114, 370 113, 324 111 C 322 88, 321 62, 322 40 Z" />
                <path d="M170 76 C 210 72, 260 80, 306 75" class="ai" />
                <path d="M296 67 L 308 75 L 297 84" class="ai" />
              </g>
              <text x="100" y="82" text-anchor="middle">V = s³</text>
              <text x="402" y="82" text-anchor="middle">Surface = 6s²</text>
            </svg>
          </div>
        </div>
      </figure>
    </main>
  </body>
</html>

<style is:global>
  :root {
    --bg: #fafaf9;
    --ink: #171717;
    --muted: #a3a3a1;
    --line: #e7e7e5;
    --ai: #9c27b0;
  }
  * { box-sizing: border-box; margin: 0; font-weight: 400; }
  html, body { height: 100%; overflow: hidden; }
  body {
    display: flex; flex-direction: column; background: var(--bg); color: var(--ink);
    font: 16px/1.6 'Inter Variable', ui-sans-serif, system-ui, sans-serif; -webkit-font-smoothing: antialiased;
  }
  a { color: inherit; text-decoration: none; }
  a:hover { color: var(--ink); }
  :focus-visible { outline: 2px solid #86efac; outline-offset: 3px; border-radius: 4px; }
  ::selection { background: #f5dff9; }
  .muted { color: var(--muted); }

  .nav { display: flex; justify-content: space-between; padding: 1.5rem 2rem; font-size: 0.9rem; }

  main { flex: 1; min-height: 0; display: flex; flex-direction: column; align-items: center; padding: 6vh 1.5rem 0; text-align: center; }
  h1 { font-size: clamp(2rem, 5.5vw, 4rem); line-height: 1.05; letter-spacing: -0.04em; max-width: 13em; }
  .btn { margin-top: 2rem; padding: 0.6rem 1.2rem; border-radius: 999px; background: var(--ink); color: #fff; font-size: 0.9rem; transition: opacity 0.2s; }
  .btn:hover { color: #fff; opacity: 0.85; }

  /* The sheet fills what's left of the viewport and fades out at the bottom edge instead of scrolling. */
  .sheet {
    flex: 1; min-height: 0; width: min(880px, 100%); margin-top: 7vh; overflow: hidden; text-align: left;
    background: #fff; border: 1px solid var(--line); border-bottom: 0; border-radius: 14px 14px 0 0;
    mask-image: linear-gradient(#000 55%, transparent);
  }
  .bar { display: flex; justify-content: space-between; align-items: center; padding: 0.8rem 1.2rem; font-size: 0.8rem; }
  .pill { display: inline-flex; align-items: center; gap: 0.35rem; border: 1px solid var(--line); border-radius: 999px; padding: 0.1rem 0.6rem; color: var(--ai); font-size: 0.72rem; }
  .dot { width: 6px; height: 6px; border-radius: 50%; background: var(--ai); animation: pulse 2.4s ease-in-out infinite; }
  .page { max-width: 540px; margin-inline: auto; padding: 2.5rem 1.5rem; }
  .prose { position: relative; font-size: 1.05rem; line-height: 1.75; }
  mark { background: #fdefff; color: inherit; border-radius: 3px; text-decoration: underline dotted #e5adef; text-underline-offset: 5px; }
  .whisper { position: absolute; left: calc(100% + 2rem); top: 0; width: 8rem; font-size: 0.78rem; line-height: 1.5; color: #737371; border-left: 1px solid #e5adef; padding-left: 0.8rem; }
  .tag { display: block; font-size: 0.65rem; letter-spacing: 0.08em; color: var(--ai); }
  .canvas { margin-top: 1.75rem; border: 1px solid var(--line); border-radius: 10px; color: #44443f; background: radial-gradient(circle, var(--line) 1px, transparent 1px) 0 0 / 18px 18px; }
  .canvas svg { display: block; width: 100%; height: auto; }
  .canvas text { font: 18px 'Inter Variable', sans-serif; letter-spacing: -0.01em; fill: currentColor; }
  .canvas .ai { stroke: var(--ai); }

  @keyframes pulse { 50% { opacity: 0.35; } }
  @media (prefers-reduced-motion: reduce) { .dot { animation: none; } }
  @media (max-width: 900px) { .whisper { display: none; } }
</style>
