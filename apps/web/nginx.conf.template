map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    root /usr/share/nginx/html;
    # largest upload the server accepts (100 MB videos) plus multipart overhead
    client_max_body_size 110m;

    # Behind the TLS proxy in docker-compose.prod.yml, $remote_addr is the proxy; take the visitor's address
    # from X-Forwarded-For, but only when it comes from a private network (never from the open internet).
    set_real_ip_from 10.0.0.0/8;
    set_real_ip_from 172.16.0.0/12;
    set_real_ip_from 192.168.0.0/16;
    real_ip_header X-Forwarded-For;
    real_ip_recursive on;

    # API + Yjs sync WebSocket. $http_host keeps the port so the server's same-origin check matches.
    location /v1/ {
        proxy_pass http://${API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        # Replaces anything the client sent: the server rate-limits guest comments by this address.
        proxy_set_header X-Real-IP $remote_addr;
        proxy_read_timeout 1h;
        # stream uploads straight to the server instead of spooling 100 MB to nginx's disk first
        proxy_request_buffering off;
    }

    # MCP Streamable HTTP (SSE responses must not be buffered)
    location /mcp {
        proxy_pass http://${API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_buffering off;
        proxy_read_timeout 1h;
    }

    location = /health { proxy_pass http://${API_UPSTREAM}; }

    location / {
        try_files $uri /index.html;
    }
}
